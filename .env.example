# Create these credentials at https://dashboard.pluggy.ai/.
PLUGGY_CLIENT_ID=replace-with-your-client-id
PLUGGY_CLIENT_SECRET=replace-with-your-client-secret

# Preferred: keep personal and company connections in separate lists.
PLUGGY_PERSONAL_ITEM_IDS=replace-with-personal-item-id-1,replace-with-personal-item-id-2
PLUGGY_AGENTIK_ITEM_IDS=replace-with-agentik-item-id-1,replace-with-agentik-item-id-2

# Legacy: one unclassified list is still accepted when the two group variables are absent.
# PLUGGY_ITEM_IDS=replace-with-item-id-1,replace-with-item-id-2

# Required only for the remote HTTP/Docker mode. Generate a long random value.
MCP_HTTP_TOKEN=replace-with-a-long-random-token
MCP_HTTP_PORT=3000

# Required only for deployment/openai-tunnel/compose.yaml.
OPENAI_TUNNEL_ID=tunnel-replace-with-your-tunnel-id
CONTROL_PLANE_API_KEY=sk-replace-with-your-runtime-key
