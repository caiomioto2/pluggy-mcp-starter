# Create these credentials at https://dashboard.pluggy.ai/.
PLUGGY_CLIENT_ID=replace-with-your-client-id
PLUGGY_CLIENT_SECRET=replace-with-your-client-secret

# One or more Pluggy Item IDs. Separate multiple connections with commas.
PLUGGY_ITEM_IDS=replace-with-item-id-1,replace-with-item-id-2

# Required only for the remote HTTP/Docker mode. Generate a long random value.
MCP_HTTP_TOKEN=replace-with-a-long-random-token
MCP_HTTP_PORT=3000
